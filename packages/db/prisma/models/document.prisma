enum DocumentCategory {
    CASE_EVIDENCE
    GOVERNING_POLICY
}

enum DocumentStatus {
    UPLOADING
    UPLOADED
    PROCESSING
    READY
    FAILED
}

model Document {
    id           String           @id @default(uuid()) @db.Uuid

    caseId       String           @db.Uuid
    case         Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)

    originalName String
    contentType  String
    sizeBytes    Int

    blobName     String           @unique

    category     DocumentCategory
    status       DocumentStatus   @default(UPLOADING)

    uploadedAt   DateTime?

    processingJobs DocumentProcessingJob[]
    chunks         DocumentChunk[]

    createdAt    DateTime         @default(now())
    updatedAt    DateTime         @updatedAt

    @@index([caseId, createdAt])
}

enum DocumentProcessingJobStatus {
    PENDING
    RUNNING
    SUCCEEDED
    FAILED
}

model DocumentProcessingJob {
    id              String                      @id @default(uuid()) @db.Uuid
    documentId      String                      @db.Uuid
    document        Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)
    pipelineVersion Int                         @default(1)
    status          DocumentProcessingJobStatus @default(PENDING)
    attempts        Int                         @default(0)
    error           String?
    leaseToken      String?                     @db.Uuid
    leaseOwner      String?
    leaseExpiresAt  DateTime?
    createdAt       DateTime                    @default(now())
    startedAt       DateTime?
    finishedAt      DateTime?
    updatedAt       DateTime                    @updatedAt

    @@unique([documentId, pipelineVersion])
    @@index([status, createdAt])
    @@index([status, leaseExpiresAt])
}

model DocumentChunk {
    id          String   @id @default(uuid()) @db.Uuid
    documentId  String   @db.Uuid
    document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
    pageNumber  Int
    chunkIndex  Int
    content     String
    createdAt   DateTime @default(now())

    @@unique([documentId, chunkIndex])
    @@index([documentId, pageNumber])
}
